#K8S
apiVersion : apps/v1
kind : Deployment
metadata: 
  name : pathnex-app
spec:
  replicas : 2
  selector :
    matchlabels :
	app : pathnex-app
    template :
	metadata:
	  labels:
	    apps: pathnex-app
    spec:
	containers:
	  -name: nginx
	   image: nginx
	   ports:
	     - containerPort:80

#Day 26
-name : Implementing SSh key-based Authentication
 hosts: all
 become : yes
 tasks : 
   - name: Generating SSH Key Pair
     command : ssh-keygen -t rsa -b 2048 -f /home/user/.ssh/id_rsa -N ""
   - name: Adding SSh public key to authorized_keys
     authorized_key:
	user : user
	state : present
	key : "{{lookup('file', '/home/user/.ssh/id_rsa.pub')}}"

#Terraform - Enabling VPC Flow Logs for Security
resource "aws_vpc_flow_log" "pathnex_flow_log" {
  log_group_name = "pathnex-flow-logs"
  vpc_id = aws_vpc_pathnex_vpc.id
  traffic_type = "ALL"
  log_destination_type = "cloud-watch-logs"
}

resource "aws_cloudwatch_log_group" "pathnex_flow_logs_groups"
{
  name = "pathnex-flow-logs"
}

# K8S -N/W Policies for Security
apiVersion : netwroking.k8s.io/v1
kind : NetworkPolicy
metadata :
  name : pathnex-web-policy
spec:
  podSelector:
    matchLabels:
	app: patnex-web-app
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - from:
	= podSelector:
	    matchLables:
		app: pathnex-api
  egress:
    - to:
	- podSelector:
	    matchLabeles:
 		app: pathnex-database
#JenkinsFile -Securing the Pipeline with secrets
